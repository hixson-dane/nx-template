{
  "name": "@org/schema-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "schema-api-e2e",
    "implicitDependencies": [
      "schema-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "schema-api:build",
          "schema-api:serve"
        ],
        "options": {
          "jestConfig": "packages/resources/schema/schema-api-e2e/jest.config.cjs",
          "passWithNoTests": true
        }
      }
    }
  }
}
