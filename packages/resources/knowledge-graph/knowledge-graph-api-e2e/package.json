{
  "name": "@org/knowledge-graph-api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "knowledge-graph-api-e2e",
    "implicitDependencies": [
      "knowledge-graph-api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "knowledge-graph-api:build",
          "knowledge-graph-api:serve"
        ],
        "options": {
          "jestConfig": "packages/resources/knowledge-graph/knowledge-graph-api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  }
}
