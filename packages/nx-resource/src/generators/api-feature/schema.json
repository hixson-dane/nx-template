{
  "$schema": "https://json-schema.org/schema",
  "$id": "NxResourceApiFeatureGenerator",
  "title": "Nx Resource API Feature Generator",
  "description": "Add a new feature set to an existing API project.",
  "type": "object",
  "properties": {
    "apiProject": {
      "type": "string",
      "description": "Target API project name in the Nx workspace.",
      "x-prompt": "Which API project should be extended?",
      "x-dropdown": "projects",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "featureName": {
      "type": "string",
      "description": "Feature name to scaffold.",
      "$default": {
        "$source": "argv",
        "index": 1
      }
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Skip file formatting.",
      "default": false
    }
  },
  "required": ["apiProject", "featureName"],
  "additionalProperties": false
}
