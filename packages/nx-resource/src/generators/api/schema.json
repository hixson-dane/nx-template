{
  "$schema": "https://json-schema.org/schema",
  "$id": "NxResourceApiGenerator",
  "title": "Nx Resource API Generator",
  "description": "Scaffold api and api-e2e projects for a resource, and reuse or create matching models.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name in kebab-case.",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    },
    "scope": {
      "type": "string",
      "description": "Workspace package scope for generated api packages (for example @org).",
      "default": "@org"
    },
    "featureName": {
      "type": "string",
      "description": "Seed feature name for api routing and model contracts.",
      "default": "ping"
    },
    "directory": {
      "type": "string",
      "description": "Base directory where resources live.",
      "default": "packages/resources"
    },
    "apiPort": {
      "type": "number",
      "description": "Default api runtime port.",
      "default": 3000
    },
    "skipFormat": {
      "type": "boolean",
      "description": "Skip file formatting.",
      "default": false
    }
  },
  "required": ["name"],
  "additionalProperties": false
}